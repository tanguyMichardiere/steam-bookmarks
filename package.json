{
	"name": "steam-overlay",
	"private": true,
	"scripts": {
		"analyze-bundle": "ANALYZE=true next build",
		"build": "next build --turbopack",
		"build:standalone": "STANDALONE_OUTPUT=true npm run build",
		"check-dead-code": "knip",
		"precheck-types": "next typegen",
		"check-types": "tsc",
		"check-updates": "npm-check-updates --reject @types/node",
		"check-updates:node": "npm-check-updates --filter @types/node --target minor",
		"dev": "next dev --turbopack",
		"env-pull": "vercel env pull .env",
		"format": "biome format --write .",
		"lint": "biome ci --error-on-warnings .",
		"quality": "npm run lint && npm run check-types && npm run check-dead-code",
		"start": "next start"
	},
	"dependencies": {
		"@heroicons/react": "2.2.0",
		"@t3-oss/env-nextjs": "0.13.8",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.16",
		"@vercel/analytics": "1.5.0",
		"client-only": "0.0.1",
		"next": "15.5.0",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"redis": "5.8.2",
		"server-only": "0.0.1",
		"tslib": "2.8.1",
		"zod": "4.1.1",
		"zustand": "5.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"@next/bundle-analyzer": "15.5.0",
		"@tailwindcss/postcss": "4.1.12",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "22.18.0",
		"@types/react": "19.1.11",
		"@types/react-dom": "19.1.7",
		"autoprefixer": "10.4.21",
		"babel-plugin-react-compiler": "19.1.0-rc.2",
		"daisyui": "5.0.50",
		"knip": "5.63.0",
		"npm-check-updates": "18.0.2",
		"postcss": "8.5.6",
		"postcss-flexbugs-fixes": "5.0.2",
		"postcss-load-config": "6.0.1",
		"postcss-preset-env": "10.3.0",
		"tailwindcss": "4.1.12",
		"typescript": "5.9.2",
		"vercel": "46.0.2"
	}
}
