{
	"name": "steam-overlay",
	"private": true,
	"scripts": {
		"analyze-bundle": "ANALYZE=true next build",
		"build": "next build",
		"check-dead-code": "knip",
		"check-types": "tsc",
		"check-updates": "npm-check-updates --reject @types/node",
		"check-updates:node": "npm-check-updates --filter @types/node --target minor",
		"dev": "next dev --turbopack",
		"env-pull": "vercel env pull .env",
		"format": "biome format --write .",
		"lint": "biome ci --error-on-warnings .",
		"quality": "npm run lint && npm run check-types && npm run check-dead-code",
		"start": "next start"
	},
	"dependencies": {
		"@t3-oss/env-nextjs": "0.13.8",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.16",
		"@vercel/analytics": "1.5.0",
		"@vercel/speed-insights": "1.2.0",
		"client-only": "0.0.1",
		"next": "15.4.6",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"redis": "5.8.1",
		"server-only": "0.0.1",
		"tslib": "2.8.1",
		"zod": "4.0.17",
		"zustand": "5.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@next/bundle-analyzer": "15.4.6",
		"@tailwindcss/postcss": "4.1.12",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "22.16.3",
		"@types/react": "19.1.10",
		"@types/react-dom": "19.1.7",
		"autoprefixer": "10.4.21",
		"babel-plugin-react-compiler": "19.1.0-rc.2",
		"daisyui": "5.0.50",
		"jiti": "2.5.1",
		"knip": "5.62.0",
		"npm-check-updates": "18.0.2",
		"postcss": "8.5.6",
		"postcss-flexbugs-fixes": "5.0.2",
		"postcss-load-config": "6.0.1",
		"postcss-preset-env": "10.2.4",
		"tailwindcss": "4.1.12",
		"typescript": "5.9.2",
		"vercel": "46.0.1"
	}
}
