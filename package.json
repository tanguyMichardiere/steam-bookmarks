{
	"dependencies": {
		"@t3-oss/env-nextjs": "0.13.8",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.16",
		"@vercel/analytics": "1.5.0",
		"@vercel/speed-insights": "1.2.0",
		"client-only": "0.0.1",
		"clsx": "2.1.1",
		"next": "15.3.4",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"server-only": "0.0.1",
		"tslib": "2.8.1",
		"zod": "3.25.67"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.5",
		"@next/bundle-analyzer": "15.3.4",
		"@tailwindcss/postcss": "4.1.10",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "22.15.32",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"autoprefixer": "10.4.21",
		"babel-plugin-react-compiler": "19.1.0-rc.2",
		"cross-env": "7.0.3",
		"daisyui": "5.0.43",
		"jiti": "2.4.2",
		"knip": "5.61.2",
		"npm-check-updates": "18.0.1",
		"postcss": "8.5.6",
		"postcss-flexbugs-fixes": "5.0.2",
		"postcss-load-config": "6.0.1",
		"postcss-preset-env": "10.2.3",
		"tailwindcss": "4.1.10",
		"typescript": "5.8.3",
		"vercel": "44.0.0",
		"webpack": "5.99.9"
	},
	"name": "steam-overlay",
	"pnpm": {
		"supportedArchitectures": {
			"cpu": [
				"x64",
				"current"
			],
			"os": [
				"linux",
				"current"
			]
		}
	},
	"private": true,
	"scripts": {
		"analyze-bundle": "cross-env ANALYZE=true next build",
		"build": "next build",
		"check-dead-code": "knip",
		"check-types": "tsc",
		"dev": "next dev --turbopack",
		"env-pull": "vercel env pull .env",
		"format": "biome format --write .",
		"lint": "biome ci --error-on-warnings .",
		"quality": "pnpm run lint && pnpm run check-types && pnpm run check-dead-code",
		"start": "next start"
	}
}
