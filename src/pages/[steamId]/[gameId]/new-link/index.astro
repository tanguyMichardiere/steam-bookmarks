---
import Layout from "../../../../Layout.astro";
import { getPlayerSummary, type PlayerSummary } from "../../../../api/getPlayerSummary";
import NewLinkForm from "../../../../components/NewLinkForm";

type Params = {
  steamId: string;
  gameId: string;
};

const params = Astro.params as Params;

let playerSummary: PlayerSummary;
try {
  playerSummary = await getPlayerSummary(params.steamId);
} catch (error) {
  console.error(error);
  return Astro.redirect("/");
}

if (playerSummary.gameid === undefined) {
  return Astro.redirect(`/${paramssteamId}`);
}
---

<Layout playerSummary={playerSummary}>
  <NewLinkForm steamId={params.steamId} gameId={params.gameId} client:only />
</Layout>
